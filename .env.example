# Copy to .env for `npm start`. What each one means: README.md, "Environment".
# In production these come from the ENV repository secret (see the deploy
# workflow), never from this file.

PORT=8181
MONGODB_URI=mongodb://localhost:27017/seemuehub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# The backend's JWT_SECRET.
JWT_SECRET_KEY=

# Optional.
CHAT_INTERNAL_KEY=
BACKEND_URL=
SOCKET_AUTH_MODE=permissive
# Where sticker images live: a STICKER message's attachment must start with
# this. An https URL ending in /; empty means this default.
STICKER_URL_PREFIX=https://seemuehub-storage.s3.ap-southeast-1.amazonaws.com/images/
# Company <-> candidate chat (README.md, "Company conversations"). "true"
# needs BACKEND_URL and CHAT_INTERNAL_KEY, and the backend's own switch.
ORG_CHAT_ENABLED=false
# Staff RBAC (README.md, "Admin oversight"). "true" lets only a password +
# TOTP admin session read chats; turned on together with the backend's own
# ADMIN_SESSION_ENFORCED, once every staff member has enrolled.
ADMIN_SESSION_ENFORCED=false
